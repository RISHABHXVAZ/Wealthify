# Wealthify Backend Configuration Template
# Copy this file to .env or set environment variables in production.
# NEVER commit actual secrets to this file or any tracked Git file.
# Spring Profile: 'prod' for production (default), 'local' for local development
# SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-hostname>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<database_user>
SPRING_DATASOURCE_PASSWORD=<database_password>

# Cryptographically secure JWT secret (minimum 256 bits, recommended 64-byte Base64 or Hex)
APP_JWT_SECRET=your_cryptographically_secure_jwt_secret_min_256_bits

# Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here

# Frontend URL for CORS
APP_FRONTEND_URL=http://localhost:5173

# Gmail SMTP for OTP Password Reset
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# OTP Rate Limiting & Abuse Prevention (Optional - sensible defaults built-in)
# APP_SECURITY_OTP_MAX_SEND_PER_IP=3
# APP_SECURITY_OTP_MAX_SEND_PER_EMAIL=3
# APP_SECURITY_OTP_SEND_WINDOW_SECONDS=600
# APP_SECURITY_OTP_MAX_VERIFY_ATTEMPTS=5
# APP_SECURITY_OTP_VERIFY_LOCKOUT_SECONDS=900
