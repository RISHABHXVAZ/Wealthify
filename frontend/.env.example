# Wealthify Frontend Configuration Template
# Copy this file to .env.local for local overrides.
#
# IMPORTANT:
# 1. Variables prefixed with VITE_ are embedded into the client bundle at build time by Vite.
# 2. NEVER put secrets, private keys, database passwords, or credentials here.
# 3. For local development, if VITE_API_URL is omitted, the frontend automatically defaults to http://localhost:8080.

# Base URL for the Wealthify backend REST API
# Local development default:
VITE_API_URL=http://localhost:8080

# Production example (set in your Vercel project environment variables):
# VITE_API_URL=https://your-backend-service.onrender.com
